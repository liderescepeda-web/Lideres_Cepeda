{
  "expo": {
    "name": "Líderes Cepeda",
    "slug": "lideres-cepeda",
    "scheme": "liderescepeda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#8F3292"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.liderescepeda.app"
    },
    "android": {
      "package": "co.liderescepeda.app",
      "adaptiveIcon": {
        "backgroundColor": "#8F3292",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
