# ============================================================================
# Líderes Cepeda — Variables de entorno (cliente)
# Copia este archivo como .env y completa los valores.
# Solo van aquí claves PÚBLICAS (anon). Las secretas viven en Supabase.
# ============================================================================

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyTU_ANON_KEY

# URL pública de la web desplegada (para enlaces de referido)
EXPO_PUBLIC_SITE_URL=https://liderescepeda.co

# ----------------------------------------------------------------------------
# Las siguientes claves NO van aquí. Se configuran como SECRETS de las
# Edge Functions de Supabase (nunca se exponen en la app):
#
#   supabase secrets set GEMINI_API_KEY=xxxxx
#
#   GEMINI_API_KEY        → https://aistudio.google.com/app/apikey
#   (SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY
#    los inyecta Supabase automáticamente en las funciones)
# ----------------------------------------------------------------------------
